# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Chrome isolated user profile and CDP session data
.chrome_isolated/
.browser_profile/

# OAuth credentials & access tokens
credentials.json
token.json
student_config.json

# Deliverables & personal coursework files (protect personal PDFs, docs, student IDs)
deliverables/*
!deliverables/.gitkeep

# Documents and archives outside deliverables
*.pdf
*.docx
*.zip

# Generated student deliverables staging directory
output/

# Archived legacy scripts and personal coursework helpers
.legacy_archive/*
!.legacy_archive/README.md

# Logs and system generated files
*.log
.system_generated/

# Extra notes, viva guides, study materials, and scratch files
notes/
*notes*
*.notes.*
study_guides/
viva_guides/
extra_notes/
scratch/
*.scratch.*
